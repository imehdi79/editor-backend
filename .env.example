# Copy to .env for local development.

# HTTP port the Nest/Fastify server listens on.
PORT=8787

# Allowed CORS origin (the Vite dev server). Comma-separate for multiple.
CORS_ORIGIN=http://localhost:5173

# Postgres connection string. Matches docker-compose.yml.
DATABASE_URL="postgresql://construct:construct@localhost:5432/construct_editor?schema=public"

# Auth — CHANGE THIS SECRET in any non-local environment.
JWT_SECRET=dev-secret-change-me
JWT_EXPIRES_IN=7d
