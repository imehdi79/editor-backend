// Construct Editor — persistence schema.
//
// IMPORTANT: the page document (shapes + viewport) is stored as an opaque JSON
// blob. The backend never reads or validates the inner CAD shape geometry, so
// future 3D fields (per-shape or per-page) require ZERO schema/migration change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String // bcrypt hash — never returned to clients
  createdAt DateTime @default(now())

  projects Project[]
  pricing  PricingSettings?

  @@map("users")
}

// Per-user pricing settings — one row per user (currency + demolition rate +
// the per-material billing rules). The `rates` map is an opaque JSON blob
// (Record<material, MaterialRate>); the backend never inspects its contents, so
// new materials / rule fields require ZERO schema change.
model PricingSettings {
  // The owning user's id is the primary key — one settings row per account.
  userId String @id

  currency     String
  demolishRate Float  @default(0)

  // Per-material billing rules, stored verbatim as jsonb. Opaque to the backend.
  rates Json

  // Epoch milliseconds (server-owned), as in Project.
  updatedAt Float

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("pricing_settings")
}

model Project {
  // Client-supplied primary key, e.g. "project-3".
  id String @id

  name         String
  activePageId String

  // Full Page[] document (incl. shapes + viewport) stored verbatim as jsonb.
  // Opaque to the backend — do not depend on its inner schema.
  pages Json

  // Epoch milliseconds. Stored as double precision (exact for integers < 2^53)
  // so they serialize straight back to JSON `number` for the frontend.
  createdAt Float
  updatedAt Float

  // Owner — every project belongs to a user. Routes are scoped by this column.
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([updatedAt])
  @@index([userId, updatedAt])
  @@map("projects")
}
